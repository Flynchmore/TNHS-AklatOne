# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (MariaDB)
DATABASE_URL="mysql://aklatone:aklatone_dev_password@localhost:3307/aklatone"

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12


# Optional services
REDIS_URL=redis://localhost:6379
EMAIL_USER=
EMAIL_PASS=

# Production / deployment
# Comma-separated web origins allowed to call the API (blank = any origin, fine for development)
CORS_ORIGINS=
# Number of reverse proxies in front of the API (1 behind nginx / Hostinger proxy / Docker web container)
TRUST_PROXY=0

# Database backups (Settings > Backup and Restore + daily automatic copy)
BACKUP_DIR=backups
BACKUP_AUTO=true
BACKUP_HOUR=2
BACKUP_KEEP=14
BACKUP_ENCRYPTION_KEY=

# Book covers kept by the server (downloaded once) and files members send (lost-book documents).
COVER_DIR=covers
UPLOAD_DIR=uploads

# Automatic return reminder (in-app + email) for loans due within REMINDER_DAYS_BEFORE days, daily at REMINDER_HOUR (PH time)
REMINDER_AUTO=true
REMINDER_HOUR=7
REMINDER_DAYS_BEFORE=1
