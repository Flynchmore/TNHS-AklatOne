ll id="c6" value="Librarian screen (phone camera is the&lt;br&gt;scanner; the only place to lend at the desk)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0FF;strokeColor=#3354B5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500.0" y="360.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Lend, Return or&lt;br&gt;Add book?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525.0" y="444.0" width="210" height="92" as="geometry"/></mxCell><mxCell id="c8" value="Take a photo of the cover / title&lt;br&gt;page, then the copyright page" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#EEFBF2;strokeColor=#15803D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640.0" y="560.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="c9" value="Text read on the phone (ML Kit):&lt;br&gt;title, author, publisher, year, ISBN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0FF;strokeColor=#3354B5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640.0" y="660.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Check the fields (tap a line to fill&lt;br&gt;one), copies; save to the catalog" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#EEFBF2;strokeColor=#15803D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640.0" y="760.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="c11" value="Scan the Library ID card&lt;br&gt;(or type the Member ID)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#EEFBF2;strokeColor=#15803D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120.0" y="560.0" width="260" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Active member&lt;br&gt;found?" style="rhombus;whiteSpace=wrap;ht