# Used by docker-compose.yml (copy to .env and fill in). Never commit the real .env.
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password
# Password of the limited API user aklatone_app (letters and numbers only, e.g. openssl rand -hex 24)
DB_APP_PASSWORD=change-this-app-password
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Gmail address + app password for sign-in codes and notices (optional)
EMAIL_USER=
EMAIL_PASS=
# Public address(es) of the Staff Web, comma-separated, e.g. https://library.example.com
CORS_ORIGINS=
# Domain of the server, e.g. library.example.com (Caddy gets the HTTPS certificate). ":80" = plain HTTP for a LAN test only.
SITE_ADDRESS=:80
# Off-server backup copy (scripts/offsite-backup.sh): rsync target over SSH, e.g. backup@nas.example.com:/backups/aklatone
OFFSITE_TARGET=
# Encrypts the daily automatic database backups on the server (keep a copy of this key somewhere safe)
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP=14
# Automatic due-soon reminder (in-app + email), daily at REMINDER_HOUR Philippine time
REMINDER_AUTO=true
REMINDER_HOUR=7
REMINDER_DAYS_BEFORE=1
